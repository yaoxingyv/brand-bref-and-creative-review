# ============================================================
# 复制本文件为 .env 后按需修改（.env 已被 git 忽略，不会误提交）
# ============================================================

# ---------- 应用 ----------
APP_NAME=企业内部问答助手
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1

# ---------- 安全（生产必须改！）----------
SECRET_KEY=dev-only-secret-change-me
JWT_EXPIRE_MINUTES=720

# ---------- 数据库 ----------
# 开发：SQLite；生产：postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ============================================================
# 问答模式（关键开关）
#   false = 通用问答助手（默认）：直接调用大模型，不检索知识库
#   true  = RAG 模式：先检索制度片段再作答，答案带来源引用
# 改成 true 即可切换，无需改代码、无需迁移数据
# ============================================================
USE_RAG=false

ASSISTANT_NAME=企业智能助手

# ============================================================
# 大模型（供应商可替换）
#   mock          = 离线假模型，零依赖零费用，仅跑通链路
#   openai_compat = OpenAI 兼容协议（DeepSeek / 通义 / GLM / vLLM 网关）
# ============================================================
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# ---------- 嵌入（RAG 模式下生效）----------
# local = 本地哈希向量（离线占位，语义弱）
# api   = 远程嵌入接口（真正的语义检索）
# 注意：切换后需调用管理端「重建索引」或重启，索引会重建
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256

# ---------- 检索 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
W_BM25=0.4
W_VEC=0.6

# ---------- 落盘目录 ----------
UPLOAD_DIR=./data/uploads
VECTOR_DIR=./data/vectordb

# ---------- 示例知识库（可选）----------
# 指向你们真实的制度文档；留空则用 reimbursement-qa-stage1/报销制度示例.md
SAMPLE_POLICY_PATH=

# ---------- 种子账号（仅开发环境）----------
SEED_ADMIN=admin
SEED_ADMIN_PASSWORD=admin123
SEED_EMPLOYEE=employee
SEED_EMPLOYEE_PASSWORD=employee123
